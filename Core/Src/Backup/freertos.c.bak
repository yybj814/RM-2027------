/* Definitions for deSG90 */
osThreadId_t deSG90Handle;
const osThreadAttr_t deSG90_attributes = {
  .name = "deSG90",
  .stack_size = 128 * 4,
  .priority = (osPriority_t) osPriorityNormal,
};

